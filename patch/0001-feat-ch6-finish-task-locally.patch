+pub fn get_mut_data<T>(token: usize, ptr: *const T) -> Option<*mut T> {
+    let size = core::mem::size_of::<T>();
+    if size == 0 {
+        println!("[task]: get data with size == 0");
+        return None;
+    }
+
+    let Some(mut byte_buffers) = translated_byte_buffer(token, ptr as *const u8, size) else {
